# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build
RUN npm run dossier:bootstrap -- /tmp/fde-dossier.sqlite

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=8800 \
    DATABASE_PATH=/data/tokendance-field.sqlite \
    DOSSIER_DB_PATH=/data/fde-dossier.sqlite \
    FIELD_REPORTS_DIR=/reports
# /reports 要在镜像里先建好并 chown：docker 给空 volume 挂载点做初始化时会继承
# 镜像里那个目录的属主。不建的话 volume 归 root，容器里的 nextjs 读不了自己的报告。
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs \
    && mkdir -p /data /reports && chown -R nextjs:nodejs /data /reports
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /tmp/fde-dossier.sqlite ./seed/fde-dossier.sqlite
USER nextjs
EXPOSE 8800
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:8800/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["sh", "-c", "if [ ! -f \"$DOSSIER_DB_PATH\" ]; then cp /app/seed/fde-dossier.sqlite \"$DOSSIER_DB_PATH\"; fi; exec node server.js"]
