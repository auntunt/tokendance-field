{
  "name": "tokendance-signal-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "dossier:bootstrap": "tsx scripts/bootstrap-dossier.ts",
    "industry:validate-feed": "tsx scripts/validate-industry-weekly-feed.ts",
    "production:check": "tsx scripts/check-production.ts",
    "report:build": "tsx scripts/build-report.ts",
    "env:check": "tsx scripts/check-env.ts",
    "start": "node .next/standalone/server.js",
    "test": "npm run test:smoke",
    "test:smoke": "npm run build && tsx --test --test-concurrency=1 tests/dossier-bootstrap.test.ts tests/fde-dossier-flow.test.ts tests/m4-dossier-output.test.ts tests/m6-industry-weekly.test.ts tests/production-config.test.ts tests/research-brief.test.ts tests/scheduler-wiring.test.ts tests/typescript-only.test.ts",
    "test:full": "npm run build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jiti": "2.7.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
