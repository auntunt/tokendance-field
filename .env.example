# 全部可配置项。代码里读到的环境变量只有这些，没有别的隐藏开关。
# 复制成 .env.local（本机开发）或服务器上的 .env（线上），然后填值。
#
# 通用校验：`npm run env:check`；生产上线：`npm run production:check -- --file .env`。

# ── 访问控制（必填）────────────────────────────────────────────────
# 整站就这一组凭据，没有注册流程。proxy.ts 拦所有路径，
# 只放过 /login、/api/login、/api/health 和几个静态图标。
# 页面走 cookie（12 小时），脚本和健康检查走 HTTP Basic。
# 两个键缺任意一个，登录接口直接 500——不是「不设密码就公开」，是干脆不能用。
FIELD_ACCESS_USER=tokendance
FIELD_ACCESS_PASSWORD=replace-with-a-long-random-password

# ── 数据落盘（有默认值，线上必须显式给）──────────────────────────
# SQLite 文件位置。默认 ./data/tokendance-field.sqlite 是相对当前工作目录的，
# 容器里必须指到挂了 volume 的路径，否则重建容器时账本连同判断记录一起消失。
DATABASE_PATH=/data/tokendance-field.sqlite

# FDE 客户档案使用独立 schema；可与旧数据库指向同一 volume 中的另一文件。
DOSSIER_DB_PATH=/data/fde-dossier.sqlite

# 报告 HTML 的目录。不给的话 app/report/route.ts 会从当前目录往上找 reports/。
# 线上指到 volume：报告是每天重跑的数据，不进镜像，换数据只要 docker cp。
FIELD_REPORTS_DIR=/reports

# ── 抽取器（/api/extract，供给管线）────────────────────────────────
# 任意 OpenAI 兼容的 Chat Completions 服务，包括自建 newapi 网关。
# 三个键必须齐全，缺一个 resolveExtractConfig 返回 null，接口报「未配置」。
# 抽取器只把语料切成候选关系，不填约束门字段——门是人过的。
EXTRACT_ENDPOINT=https://your-gateway.example.com/v1/chat/completions
EXTRACT_API_KEY=
EXTRACT_MODEL=

# ── 模型批评器（/api/analyze，可选）───────────────────────────────
# 按服务商分别放密钥；请求体里带了 apiKey 就优先用请求体的，环境变量是兜底。
# 地址由前端「模型连接器」填，环境变量只管密钥——所以想走自建网关的话，
# 把密钥放进对应服务商这一格，地址在界面里填网关地址。
#
# 注意协议差异：anthropic 走 /v1/messages + x-api-key；openai 走 /v1/responses
# （不是 chat/completions，很多网关不实现这个）；deepseek 和 compatible 走
# chat/completions。选服务商等于选协议，网关不支持那个协议就会 500。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── 联网研究（/api/query，可选；无密钥时自动回退 Bing）────────────
# auto 的优先级是 xAI → OpenAI → Bing。Anthropic 需显式写 anthropic，
# 避免已有的批评器密钥在不知情时产生联网搜索费用。
RESEARCH_SEARCH_PROVIDER=auto

# Grok 使用 xAI Responses API 的 web_search 工具。默认模型来自 xAI 官方示例，
# 可以随服务端模型升级单独覆盖，不需要改代码。
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_WEB_SEARCH_MODEL=grok-4.6

# OpenAI 同样走 Responses API；OPENAI_API_KEY 与上方批评器共用。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WEB_SEARCH_MODEL=gpt-5

# Claude 联网搜索使用 Messages API 的服务端 web_search 工具。
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_WEB_SEARCH_MODEL=claude-sonnet-4-6

# 批评器的超时上限，毫秒，默认 120000。
# 推理类模型冷启动几十秒是常事，调低了会把正常调用判成超时。
ANALYZE_TIMEOUT_MS=120000

# ── 旧按公司定时补数（冻结，默认关闭）────────────────────────────
# 新 FDE 档案不按公司轮询；旧模块只为兼容保留，不在服务启动时自动运行。
FDE_SCHEDULER_ENABLED=false
FDE_SCHEDULER_INTERVAL_HOURS=6

# 每个完整批次最多新增 4 条信号、6 条关系；整张关系图达到 48 条边后停止自动扩张。
# 达到容量后停止自动扩张；过期与历史信号保留，由展示层按事件日期降序。
FDE_SCHEDULER_MAX_ADDED_SIGNALS=4
FDE_SCHEDULER_MAX_ADDED_EDGES=6
FDE_SCHEDULER_MAX_GRAPH_EDGES=48

# ── M6 行业周报（每周一次）───────────────────────────────────────
# GitHub Actions 每周把 FIELD_CRON_SECRET 作为 Bearer 发到生产接口；
# 这里必须配置同一个值。Docker 容器仍只运行一个 Next.js 服务。
CRON_SECRET=replace-with-a-separate-random-secret
INDUSTRY_WEEKLY_INDUSTRY_ID=construction-digitalization
INDUSTRY_WEEKLY_FEED_URLS=https://your-gateway.example.com/industry-weekly.json

# ── 杂项 ──────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
